{
  "name": "@traycer-clients/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Traycer SSH: independent desktop client for existing Traycer hosts over OpenSSH.",
  "homepage": "https://github.com/Krat12/traycer-ssh",
  "license": "MIT",
  "author": {
    "name": "Traycer AI",
    "email": "support@traycer.ai"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "clean:main": "rimraf dist/main dist/packages dist/protocol dist/clients",
    "compile": "tsgo --noEmit -p tsconfig.json",
    "build:main": "bun run clean:main && bun scripts/build-main-bundle.cjs",
    "build:renderer": "vite build --config vite.renderer.config.ts && bun scripts/assert-single-instance-deps.cjs",
    "build:app": "bun run clean && bun run build:main && bun run build:renderer",
    "prepack:check-cli": "bun scripts/prepack/check-cli-resource.cjs",
    "prepack:check-icons": "bun scripts/prepack/check-bundle-icons.cjs",
    "prepack:check-tray": "bun scripts/prepack/check-tray-assets.cjs",
    "build": "bun run build:app",
    "package": "bun scripts/package-ssh.cjs",
    "package:dir": "bun scripts/package-ssh.cjs --dir",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:main": "bun run build:main && bun scripts/dev/dev-main.cjs",
    "dev": "bun scripts/dev/dev-stack.cjs",
    "lint": "oxlint -c oxlint.config.mts --fix --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:resolution": "VITE_DESKTOP_LOCAL_STORAGE_KEY=traycer-resolution-test-local-storage-key bun run build:app && bun scripts/resolution/run-resolution-matrix.cjs",
    "test:packaging": "vitest run --config vitest.config.packaging.ts",
    "package:ssh": "bun scripts/package-ssh.cjs"
  },
  "dependencies": {
    "@sentry/browser": "catalog:",
    "@sentry/electron": "catalog:",
    "electron-log": "catalog:",
    "electron-updater": "^6.8.9",
    "encrypt-storage": "catalog:",
    "font-list": "^2.1.0",
    "perfect-freehand": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "catalog:",
    "@sentry/core": "catalog:",
    "@sentry/esbuild-plugin": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "build": {
    "appId": "io.github.krat12.traycer-ssh",
    "productName": "Traycer SSH",
    "artifactName": "Traycer-SSH-${version}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "directories": {
      "buildResources": "resources/bundle",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "node_modules/font-list/**/*"
    ],
    "asarUnpack": [
      "node_modules/font-list/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/app",
        "to": "app",
        "filter": [
          "**/*.png"
        ]
      },
      {
        "from": "dist/renderer",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "resources/tray",
        "to": "tray",
        "filter": [
          "**/*.png"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Traycer SSH",
        "schemes": [
          "traycer-ssh"
        ]
      }
    ],
    "publish": null,
    "mac": {
      "artifactName": "Traycer-SSH-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "12.0",
      "entitlements": "resources/bundle/entitlements.mac.plist",
      "entitlementsInherit": "resources/bundle/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Traycer uses the microphone for voice dictation in the composer."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "artifactName": "Traycer-SSH-${version}-win-${arch}.${ext}",
      "icon": "icon.ico",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Traycer SSH"
    },
    "linux": {
      "artifactName": "Traycer-SSH-${version}-linux-${arch}.${ext}",
      "executableName": "traycer-ssh",
      "icon": "icons",
      "syncDesktopName": true,
      "maintainer": "Traycer AI <support@traycer.ai>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "background": "resources/bundle/dmg/assets/dmg-background.png",
      "window": {
        "width": 642,
        "height": 406
      },
      "iconSize": 128,
      "contents": [
        {
          "x": 170,
          "y": 187,
          "type": "file"
        },
        {
          "x": 470,
          "y": 187,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "desktopName": "traycer-ssh.desktop",
  "productName": "Traycer SSH"
}
